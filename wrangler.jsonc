{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "appu-ragdoll",
  "compatibility_date": "2026-11-05",

  "workers_dev": false,

  "preview_urls": false,

  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "routes": [
    {
      "pattern": "www.ragdoll.appu.uk",
      "custom_domain": true
    }
  ]
}
